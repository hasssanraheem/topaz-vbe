# Server port
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/topaz-vbe?retryWrites=true&w=majority&appName=Cluster0

# Firebase Admin SDK (from service account JSON — never commit actual values)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email domain used for seeded accounts (e.g. admin@sim.local, team1@sim.local)
SEED_DOMAIN=sim.local

# Allowed client origins (comma-separated)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Seed passwords — change these before running seed script
ADMIN_PASSWORD=
TEAM1_PASSWORD=
TEAM2_PASSWORD=
TEAM3_PASSWORD=
TEAM4_PASSWORD=
TEAM5_PASSWORD=
TEAM6_PASSWORD=
TEAM7_PASSWORD=
TEAM8_PASSWORD=
